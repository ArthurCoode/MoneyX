# Modelo do .env (o Compose lê o arquivo .env desta pasta sozinho). Copie para ".env" e preencha.
# O .env de verdade NUNCA vai para o Git (está no .gitignore).

# ---------------------------------------------------------------- obrigatórias
# Banco de dados (o Compose cria o banco e o usuário na primeira subida).
POSTGRES_DB=moneyx
POSTGRES_USER=moneyx
# Senha forte (gerador CRIPTOGRÁFICO; nunca Get-Random). PowerShell:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
# Linux/macOS: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave AES-256 que cifra os segredos dos webhooks no banco: 32 bytes em Base64.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Linux/macOS: openssl rand -base64 32
MONEYX_WEBHOOK_ENCRYPTION_KEY=

# ---------------------------------------------------------------- opcionais
# Durante uma rotação da chave acima: a chave ANTERIOR (só decifra). Vazio = nenhuma.
MONEYX_WEBHOOK_ENCRYPTION_KEY_PREVIOUS=

# Provedor Pix: "sandbox" (padrão, cobranças simuladas) ou "mercadopago" (precisa das credenciais abaixo).
MONEYX_PIX_PROVIDER=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
